# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — ห้าม commit ไฟล์ .env

# connection string จาก Neon Console → Connect (ตอนทดสอบแนะนำให้ใช้ branch dev)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# serial ของมือถือ (ดูจากคำสั่ง adb devices) — ปล่อยว่างได้ถ้าต่อมือถือเครื่องเดียว
DEVICE_SERIAL=

# เบอร์ของทีมที่ใช้ทดสอบ คั่นด้วยจุลภาค — ตอน safety.test_mode เป็น true บอทจะทักได้เฉพาะเบอร์เหล่านี้
TEST_PHONES=0812345678,0898765432

# แจ้งเตือนพนักงานทาง Telegram เมื่อร้านตอบ (ไม่ใส่ก็ได้ — จะเห็นแค่ใน logs/worker.log)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# รหัสผ่านหน้า dashboard — ต้องใส่ถ้าจะเปิดให้เครื่องอื่นเข้า (python -m bot dashboard --lan)
DASHBOARD_PASSWORD=
